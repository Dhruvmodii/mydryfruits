# =============================================================================
# MyDryFruits — production environment template
# Copy to repo root as `.env` on the server (or run: bash deploy/write-env.sh).
# NEVER commit a real `.env` file.
# =============================================================================

NODE_ENV=production

# --- MySQL on the same EC2 (not RDS) ---
DATABASE_URL="mysql://mydryfruits:CHANGE_THIS_PASSWORD@127.0.0.1:3306/mydryfruits"

# --- API (same domain via Nginx — no api. subdomain required) ---
PORT=4000
PUBLIC_API_URL="https://dhruvmodi.online"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="https://dhruvmodi.online,https://www.dhruvmodi.online"
SITE_URL="https://dhruvmodi.online"
TRUST_PROXY=true
ADMIN_EMAIL="admin@dhruvmodi.online"
ADMIN_PASSWORD="Admin12345"

# --- Uploads on EC2 disk (free; no Cloudinary required) ---
UPLOAD_DRIVER=local
UPLOAD_DIR="/var/www/mydryfruits/uploads"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email optional (leave empty; shop still works) ---
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
SENDGRID_FROM_NAME="MyDryFruits"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Payments off ---
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- Next.js (must match SITE_URL for same-origin Nginx) ---
NEXT_PUBLIC_API_URL="https://dhruvmodi.online"
NEXT_PUBLIC_SITE_URL="https://dhruvmodi.online"
NEXT_PUBLIC_SITE_NAME="MyDryFruits"
NEXT_PUBLIC_PAYMENTS_ENABLED=false
INTERNAL_API_URL="http://127.0.0.1:4000"
