# =============================================================================
# MyDryFruits — production environment template
# Copy to repo root as `.env` on the EC2 server and fill in real values.
# NEVER commit a real `.env` file.
# =============================================================================

# --- Runtime ---
NODE_ENV=production

# --- MySQL (Prisma) ---
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://mydryfruits:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/mydryfruits"

# --- API ---
PORT=4000
# Public URL of the API (used for absolute upload URLs + clients)
PUBLIC_API_URL="https://api.yourdomain.com"
# Or same host with path/port: https://yourdomain.com:4000
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="7d"
# Comma-separated allowed browser origins (must match the live site URL)
CORS_ORIGIN="https://yourdomain.com"
SITE_URL="https://yourdomain.com"
TRUST_PROXY=true
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"

# --- Uploads ---
# local = store on EC2 disk (default, recommended). cloudinary = Cloudinary CDN.
UPLOAD_DRIVER=local
# Absolute path on the server (leave empty to use apps/api/uploads)
UPLOAD_DIR="/var/www/mydryfruits/uploads"

# Cloudinary (required only if UPLOAD_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email (env vars take priority over Admin → Settings integrations) ---
# Option A: SendGrid HTTP API
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="orders@yourdomain.com"
SENDGRID_FROM_NAME="MyDryFruits"

# Option B: SMTP (SendGrid SMTP relay or other provider)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS=""
SMTP_FROM="MyDryFruits <orders@yourdomain.com>"

# --- Payments (Razorpay) ---
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- Next.js (MUST be set before `npm run build`) ---
NEXT_PUBLIC_API_URL="https://api.yourdomain.com"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_SITE_NAME="MyDryFruits"
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Optional: used only if you run MySQL via docker compose on the server
MYSQL_ROOT_PASSWORD="CHANGE_ME_ROOT"
MYSQL_PASSWORD="CHANGE_ME_DB_PASSWORD"
